<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Farm My Country - Admin Panel</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: Arial, sans-serif; background: #1a1a1a; color: white; padding: 20px; }
.container { max-width: 600px; margin: 0 auto; }
h1 { color: #FFD700; margin-bottom: 20px; text-align: center; }
.section { background: #2a2a2a; padding: 20px; border-radius: 12px; margin-bottom: 16px; }
.section h2 { color: #52BE80; margin-bottom: 12px; font-size: 18px; }
.input-group { margin-bottom: 12px; }
.input-group label { display: block; margin-bottom: 6px; font-size: 14px; color: #aaa; }
.input-group input { width: 100%; padding: 10px; background: #1a1a1a; border: 1px solid #444; border-radius: 8px; color: white; font-size: 14px; }
.btn { width: 100%; padding: 12px; background: linear-gradient(180deg, #52BE80 0%, #27AE60 100%); border: none; border-radius: 8px; color: white; font-weight: bold; cursor: pointer; font-size: 16px; margin-top: 10px; }
.btn:active { transform: scale(0.98); }
.password-section { text-align: center; padding: 40px 20px; }
.password-section input { width: 100%; max-width: 300px; padding: 12px; background: #2a2a2a; border: 2px solid #52BE80; border-radius: 8px; color: white; font-size: 16px; text-align: center; }
.hidden { display: none; }
.success { color: #52BE80; text-align: center; margin-top: 10px; }
</style>
</head>
<body>
<div class="container">
    <div id="password-section" class="password-section">
        <h1>🔐 Admin Panel</h1>
        <p style="margin-bottom: 20px; color: #aaa;">Şifreyi girin</p>
        <input type="password" id="admin-password" placeholder="Şifre">
        <button class="btn" onclick="checkPassword()" style="max-width: 300px; margin: 20px auto 0;">Giriş</button>
        <p id="error-msg" style="color: #e74c3c; margin-top: 10px;"></p>
    </div>

    <div id="admin-content" class="hidden">
        <h1>️ Admin Panel</h1>
        
        <div class="section">
            <h2>💰 Fiyatlar (Coin)</h2>
            <div class="input-group">
                <label>🌾 Buğday Tarlası</label>
                <input type="number" id="price-wheat" value="1000">
            </div>
            <div class="input-group">
                <label> Tavuk</label>
                <input type="number" id="price-chicken" value="5000">
            </div>
            <div class="input-group">
                <label>🐄 İnek</label>
                <input type="number" id="price-cow" value="25000">
            </div>
            <div class="input-group">
                <label>🐐 Keçi</label>
                <input type="number" id="price-goat" value="100000">
            </div>
            <div class="input-group">
                <label>🐑 Koyun</label>
                <input type="number" id="price-sheep" value="500000">
            </div>
            <div class="input-group">
                <label>🧀 Peynir Fabrikası</label>
                <input type="number" id="price-cheese" value="1000000">
            </div>
            <button class="btn" onclick="savePrices()">💾 Fiyatları Kaydet</button>
        </div>

        <div class="section">
            <h2> Üretim (Dakikada)</h2>
            <div class="input-group">
                <label>🌾 Buğday</label>
                <input type="number" id="prod-wheat" value="1">
            </div>
            <div class="input-group">
                <label>🐔 Yumurta (Tavuk başına)</label>
                <input type="number" id="prod-chicken" value="2">
            </div>
            <div class="input-group">
                <label>🐄 Süt (İnek başına)</label>
                <input type="number" id="prod-cow" value="4">
            </div>
            <div class="input-group">
                <label>🐐 Keçi Sütü (Keçi başına)</label>
                <input type="number" id="prod-goat" value="8">
            </div>
            <div class="input-group">
                <label>🐑 Koyun Sütü (Koyun başına)</label>
                <input type="number" id="prod-sheep" value="16">
            </div>
            <button class="btn" onclick="saveProduction()">💾 Üretimi Kaydet</button>
        </div>

        <div class="section">
            <h2>📢 Telegram Kanal Linki</h2>
            <div class="input-group">
                <label>Görev için kanal linki</label>
                <input type="text" id="telegram-channel" value="https://t.me/YourChannel">
            </div>
            <button class="btn" onclick="saveTelegram()">💾 Kaydet</button>
        </div>

        <div class="section">
            <h2>💵 Bucks → Coin Oranı</h2>
            <div class="input-group">
                <label>1 Buck = Kaç Coin?</label>
                <input type="number" id="bucks-ratio" value="10000">
            </div>
            <button class="btn" onclick="saveRatio()">💾 Kaydet</button>
        </div>

        <button class="btn" onclick="resetAll()" style="background: linear-gradient(180deg, #e74c3c 0%, #c0392b 100%); margin-top: 20px;">🗑️ Tüm Verileri Sıfırla</button>
    </div>
</div>

<script>
const ADMIN_PASSWORD = 'admin123'; // Şifreyi değiştir!

function checkPassword() {
    const pwd = document.getElementById('admin-password').value;
    if (pwd === ADMIN_PASSWORD) {
        document.getElementById('password-section').classList.add('hidden');
        document.getElementById('admin-content').classList.remove('hidden');
        loadConfig();
    } else {
        document.getElementById('error-msg').textContent = '❌ Yanlış şifre!';
    }
}

function loadConfig() {
    const saved = localStorage.getItem('adminConfig');
    if (saved) {
        const config = JSON.parse(saved);
        document.getElementById('price-wheat').value = config.prices.wheat;
        document.getElementById('price-chicken').value = config.prices.chicken;
        document.getElementById('price-cow').value = config.prices.cow;
        document.getElementById('price-goat').value = config.prices.goat;
        document.getElementById('price-sheep').value = config.prices.sheep;
        document.getElementById('price-cheese').value = config.prices.cheese;
        document.getElementById('prod-wheat').value = config.production.wheat;
        document.getElementById('prod-chicken').value = config.production.chicken;
        document.getElementById('prod-cow').value = config.production.cow;
        document.getElementById('prod-goat').value = config.production.goat;
        document.getElementById('prod-sheep').value = config.production.sheep;
        document.getElementById('telegram-channel').value = config.telegramChannel;
        document.getElementById('bucks-ratio').value = config.bucksToCoins;
    }
}

function saveConfig() {
    const config = {
        prices: {
            wheat: parseInt(document.getElementById('price-wheat').value),
            chicken: parseInt(document.getElementById('price-chicken').value),
            cow: parseInt(document.getElementById('price-cow').value),
            goat: parseInt(document.getElementById('price-goat').value),
            sheep: parseInt(document.getElementById('price-sheep').value),
            cheese: parseInt(document.getElementById('price-cheese').value)
        },
        production: {
            wheat: parseInt(document.getElementById('prod-wheat').value),
            chicken: parseInt(document.getElementById('prod-chicken').value),
            cow: parseInt(document.getElementById('prod-cow').value),
            goat: parseInt(document.getElementById('prod-goat').value),
            sheep: parseInt(document.getElementById('prod-sheep').value)
        },
        telegramChannel: document.getElementById('telegram-channel').value,
        bucksToCoins: parseInt(document.getElementById('bucks-ratio').value)
    };
    localStorage.setItem('adminConfig', JSON.stringify(config));
    alert('✅ Kaydedildi! Oyunu yeniden yükle.');
}

function savePrices() { saveConfig(); }
function saveProduction() { saveConfig(); }
function saveTelegram() { saveConfig(); }
function saveRatio() { saveConfig(); }

function resetAll() {
    if (confirm('Tüm oyun verileri silinecek! Emin misin?')) {
        localStorage.removeItem('farmState');
        localStorage.removeItem('adminConfig');
        alert('✅ Tüm veriler sıfırlandı!');
        location.reload();
    }
}
</script>
</body>
</html>
